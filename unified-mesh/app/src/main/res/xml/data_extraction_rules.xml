<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or transferred. Message history and radio associations are
  local to the device on purpose: a cloud backup of a mesh operator's traffic is
  not something this app should create on their behalf.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
